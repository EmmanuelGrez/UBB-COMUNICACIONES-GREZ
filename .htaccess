# --- UBB: proteger archivos internos ---
Options -Indexes

# Configuracion, respaldos, datos y codigo fuente
<FilesMatch "(?i)^(docker-compose.*|Dockerfile.*|composer\.(json|lock)|README\.md|.*\.(ya?ml|bak|tsv|csv|py|sql|sh|log|key|pem|crt|env|ini)|\.ht.*)$">
    Require all denied
</FilesMatch>

# Scripts de prueba
<FilesMatch "(?i)^(prueba.*|verificar-.*)\.php$">
    Require all denied
</FilesMatch>

# Carpetas internas (incluye el historial de Git: tiene el código completo)
RedirectMatch 404 "^/(vendor|respaldos|pruebas-uisp)(/|$)"
RedirectMatch 404 "/\.(git|svn|hg)(/|$)"
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>

# Bloquear respaldos, llaves y datos sueltos
<FilesMatch "(\.bak|\.orig$|\.sql|\.tar|\.zip$|\.tsv$|\.key$|\.pem$|\.py$|\.sh$|\.log$)">
    Require all denied
</FilesMatch>

# Bloquear copias de archivos PHP (index.php.algo)
<FilesMatch "\.php\.">
    Require all denied
</FilesMatch>

# --- UBB: aviso para celulares y computadoras de clientes cortados ---
# Al conectarse, Android, iPhone, Windows y Firefox piden estas direcciones para saber si hay internet.
# Un cliente en CLIENTES-DEUDORES llega aquí (el router desvía el puerto 80); al recibir una redirección
# el equipo muestra "Iniciar sesión en la red" y abre la página de aviso. Antes recibían 404 y solo decían
# "Sin conexión a Internet".
RedirectMatch 302 "(?i)^/(generate_204|gen_204|hotspot-detect\.html|library/test/success\.html|connecttest\.txt|ncsi\.txt|redirect|canonical\.html|success\.txt|kindle-wifi/wifistub\.html|mobile/status\.php|check_network_status\.txt)$" /adeudo/
